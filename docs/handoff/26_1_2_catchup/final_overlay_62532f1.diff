+        }
+    }
+
+    public static void queueOcularRing(BedrockRenderSnapshot snapshot, RenderType renderType) {
+        if (!snapshot.isEmpty()) {
+            PENDING_RINGS.add(new RingDraw(snapshot, renderType));
